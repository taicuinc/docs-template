---
import Search from './Search.astro';
import MobileDocsMenu from './MobileDocsMenu.astro';
import { headerLinks, isExternal } from '../lib/navigation';
import { site, type Heading } from '../lib/site';

interface Props {
  current?: string;
  headings?: Heading[];
  child?: string;
}

const { current, headings = [], child } = Astro.props;
---

<div class="site-header-slot" data-scroll-header-slot>
  <nav class="site-header" aria-label="Main navigation" data-scroll-header>
    <a class="wordmark" href="/" aria-label={`${site.name} home`}>{site.name}</a>
    <Search />
    {headerLinks.map((link) => (
      <a class="header-action sidebar-link" href={link.href} target={isExternal(link.href) ? '_blank' : undefined} rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}>
        {link.icon && <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={link.icon} />}
        <span>{link.label}</span>
      </a>
    ))}
    <MobileDocsMenu current={current} headings={headings} child={child} />
  </nav>
</div>
