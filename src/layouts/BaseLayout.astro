---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist/wght-italic.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@fontsource/geist-pixel/400.css';
import '../styles/global.scss';
import { formatPageTitle } from '../lib/page-title';
import { site } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  markdownPath?: string;
  // For a page that the site does not link to and that should stay out of search results.
  noindex?: boolean;
}

const { title, description = site.description, markdownPath, noindex = false } = Astro.props;
const pageTitle = formatPageTitle(title);
const canonicalPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site);
const socialImage = site.socialImage && new URL(site.socialImage, Astro.site);
---

<!doctype html>
<html lang="en" data-sidebar={site.sidebar}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <link rel="icon" type={site.favicon.endsWith('.svg') ? 'image/svg+xml' : undefined} href={site.favicon} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} title={`${title ?? site.name} as Markdown`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <style is:inline>
      html[data-initial-hash] { scroll-behavior: auto; }
      a { color: inherit; text-decoration: none; }
      button.header-action { appearance: none; border: 1px solid transparent; outline: 0; background: transparent; color: inherit; font: inherit; }
    </style>
    <script is:inline>
      if (window.location.hash) {
        document.documentElement.dataset.initialHash = '';
        window.addEventListener('load', () => {
          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(() => delete document.documentElement.dataset.initialHash);
          });
        }, { once: true });
      }
    </script>
  </head>
  <body><slot /></body>
</html>

<script>
  import '../scripts/site';
</script>
